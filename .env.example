# ============================
# ScraperbilletV1 - Variables d'environnement
# ============================

# MongoDB Connection String
# Obtenir de MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/scraperbillet?retryWrites=true&w=majority

# Telegram Bot Token (optionnel, pour la suite)
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij

# Telegram Chat ID pour recevoir les alertes
TELEGRAM_CHAT_ID=-1001234567890

# Port de l'API (défaut: 5000)
PORT=5000

# Environment
ENVIRONMENT=production

# Délai entre les requêtes (secondes)
SCRAPE_DELAY=2

# Heure de notification quotidienne (format HH:MM, fuseau horaire UTC)
NOTIFICATION_TIME=12:00
