{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 5,
    "healthcheck": {
      "test": ["CMD", "curl", "-f", "http://localhost:5000/health"],
      "interval": 30,
      "timeout": 10,
      "retries": 3,
      "startPeriod": 5
    }
  },
  "services": [
    {
      "name": "MongoDB",
      "source": "mongodb"
    }
  ]
}
